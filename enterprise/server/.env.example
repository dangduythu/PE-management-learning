# IT-managed configuration; never commit real secrets
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://pe_app:replace-me@127.0.0.1:5432/pe_management
OIDC_ISSUER=https://identity.example.internal/tenant
OIDC_AUDIENCE=pe-management-api
OIDC_JWKS_URL=https://identity.example.internal/.well-known/jwks.json
CORS_ORIGIN=http://localhost:5173
# Production requires all OIDC vars, internal TLS termination and IT-issued identities
